<% content_for :title, "AutoGallery | Fotografías" %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 fade-in-up">
  <div>
    <p class="section-label mb-2">Gestión de fotografías</p>
    <h1 class="display-6 fw-bold mb-2">Galería completa</h1>
    <p class="support-copy mb-0">Revisa las fotografías vinculadas a cada vehículo.</p>
  </div>
</div>

<div class="row g-4">
  <% @fotografias.each do |fotografia| %>
    <div class="col-12 col-sm-6 col-lg-4">
      <article class="card gallery-card h-100 fade-in-up">
        <figure class="photo-frame mb-0">
          <%= image_tag fotografia.ruta_archivo, class: "photo-image", alt: fotografia.angulo.presence || fotografia.vehiculo.modelo, loading: "lazy" %>
        </figure>
        <div class="card-body d-flex flex-column">
          <h3 class="h6 fw-bold mb-1"><%= fotografia.vehiculo.modelo %></h3>
          <p class="gallery-subtitle mb-3">Marca: <%= fotografia.vehiculo.marca.nombre_marca %></p>
          <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mt-auto">
            <span class="text-muted"><%= fotografia.angulo.presence || "Sin ángulo" %></span>
            <div class="d-flex gap-2 flex-wrap">
              <%= link_to "Editar", edit_fotografia_path(fotografia), class: "btn btn-outline-autogallery" %>
              <%= link_to "Ver vehículo", vehiculo_path(fotografia.vehiculo), class: "btn btn-autogallery" %>
            </div>
          </div>
        </div>
      </article>
    </div>
  <% end %>
</div>
