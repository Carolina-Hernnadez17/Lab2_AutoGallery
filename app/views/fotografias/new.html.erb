<% content_for :title, "AutoGallery | Nueva fotografía" %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="detail-card p-4 p-md-5 fade-in-up">
      <p class="section-label mb-2">Alta de fotografía</p>
      <h1 class="h2 fw-bold mb-2">Subir Fotografía</h1>
      <p class="support-copy mb-4">La ruta puede ser una URL pública o una ruta local.</p>

      <%= render "form", fotografia: @fotografia %>
    </div>
  </div>
</div>