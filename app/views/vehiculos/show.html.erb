<% content_for :title, "AutoGallery | #{@vehiculo.modelo}" %>

<div class="row g-4 align-items-start fade-in-up">
  <div class="col-lg-5">
    <div class="brand-breadcrumb mb-3">
      <%= link_to "Volver a #{@vehiculo.marca.nombre_marca}", marca_path(@vehiculo.marca_id), class: "btn btn-outline-autogallery btn-sm" %>
      <span class="text-muted">/</span>
      <span class="text-muted"><%= @vehiculo.modelo %></span>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-3">
      <%= link_to "Agregar fotografía", new_fotografia_path(vehiculo_id: @vehiculo.id), class: "btn btn-autogallery" %>
      <%= link_to "Editar vehículo", edit_vehiculo_path(@vehiculo), class: "btn btn-outline-autogallery" %>
      <%= link_to "Crear otro vehículo", new_vehiculo_path(marca_id: @vehiculo.marca_id), class: "btn btn-outline-autogallery" %>
      <%= button_to "Eliminar vehículo", vehiculo_path(@vehiculo), method: :delete, form_class: "d-inline", class: "btn btn-outline-autogallery", data: { turbo_confirm: "¿Seguro que quieres eliminar este vehículo y sus fotografías?" } %>
    </div>

    <div class="detail-card p-4 h-100">
      <p class="section-label mb-2">Ficha del vehículo</p>
      <h1 class="display-6 fw-bold mb-3"><%= @vehiculo.modelo %></h1>
      <div class="d-flex flex-wrap gap-3 mb-4">
        <div class="metric-box">
          <strong><%= @vehiculo.anio.presence || "--" %></strong>
          <span>Año</span>
        </div>
        <div class="metric-box">
          <strong><%= @vehiculo.color.presence || "--" %></strong>
          <span>Color</span>
        </div>
        <div class="metric-box">
          <strong><%= number_to_currency(@vehiculo.precio || 0, unit: "$", precision: 0) %></strong>
          <span>Precio</span>
        </div>
        <div class="metric-box">
          <strong><%= @vehiculo.fotografias.size %></strong>
          <span>Fotos</span>
        </div>
      </div>

      <p class="support-copy mb-0">
        <strong class="text-white">Marca:</strong> <%= @vehiculo.marca.nombre_marca %><br>
        Revisa la galería completa para ver cada ángulo del vehículo.
      </p>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="carousel-shell p-3 p-md-4">
      <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-3">
        <div>
          <p class="section-label mb-2">Fotografías</p>
          <h2 class="h4 fw-bold mb-0">Galería del vehículo</h2>
        </div>
        <span class="text-muted"><%= @vehiculo.fotografias.size %> imágenes</span>
      </div>

      <div class="row g-3">
        <% if @vehiculo.fotografias.any? %>
          <% @vehiculo.fotografias.each do |fotografia| %>
            <div class="col-12 col-sm-6">
              <figure class="photo-frame rounded-4 mb-0">
                <%= image_tag fotografia.ruta_archivo, class: "photo-image", alt: fotografia.angulo.presence || @vehiculo.modelo, loading: "lazy" %>
              </figure>
              <div class="photo-caption mt-2">
                <strong class="text-white"><%= fotografia.angulo.presence || "Sin ángulo" %></strong>
                <span class="d-block"><%= fotografia.fecha_subida&.strftime("%d/%m/%Y") || "Fecha no definida" %></span>
                <div class="d-flex gap-2 flex-wrap mt-2">
                  <%= link_to "Editar", edit_fotografia_path(fotografia), class: "btn btn-outline-autogallery btn-sm" %>
                  <%= button_to "Eliminar", fotografia_path(fotografia), method: :delete, form_class: "d-inline", class: "btn btn-outline-autogallery btn-sm", data: { turbo_confirm: "¿Seguro que quieres eliminar esta fotografía?" } %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="col-12">
            <div class="empty-state">
              Este vehículo todavía no tiene fotografías cargadas.
              <div class="mt-3">
                <%= link_to "Agregar fotografía", new_fotografia_path(vehiculo_id: @vehiculo.id), class: "btn btn-autogallery" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>