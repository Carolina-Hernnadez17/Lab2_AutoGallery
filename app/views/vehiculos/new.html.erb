<% content_for :title, "AutoGallery | Nuevo vehículo" %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="detail-card p-4 p-md-5 fade-in-up">
      <p class="section-label mb-2">Alta de vehículo</p>
      <h1 class="h2 fw-bold mb-2">Crear vehículo para <%= @marca.nombre_marca %></h1>
      <p class="support-copy mb-4">El vehículo quedará ligado a esta marca automáticamente.</p>

      <%= form_with model: [@marca, @vehiculo], class: "row g-3" do |form| %>
        <div class="col-12">
          <%= form.label :modelo, class: "form-label" %>
          <%= form.text_field :modelo, class: "form-control form-control-lg", placeholder: "Ej. Civic Type R" %>
        </div>

        <div class="col-md-4">
          <%= form.label :anio, class: "form-label" %>
          <%= form.number_field :anio, class: "form-control form-control-lg", placeholder: "2026" %>
        </div>

        <div class="col-md-8">
          <%= form.label :color, class: "form-label" %>
          <%= form.text_field :color, class: "form-control form-control-lg", placeholder: "Ej. Negro mate" %>
        </div>

        <div class="col-12 d-flex gap-2 flex-wrap">
          <%= form.submit "Guardar vehículo", class: "btn btn-autogallery" %>
          <%= link_to "Volver", marca_path(@marca), class: "btn btn-outline-autogallery" %>
        </div>
      <% end %>
    </div>
  </div>
</div>