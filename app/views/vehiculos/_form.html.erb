<%= form_with model: vehiculo, class: "row g-3" do |form| %>
  <% if vehiculo.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <strong>Revisa los datos:</strong>
        <ul class="mb-0">
          <% vehiculo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-12">
    <%= form.label :marca_id, "Marca", class: "form-label fw-bold" %>
    <%= form.collection_select :marca_id, Marca.order(:nombre_marca), :id, :nombre_marca, { prompt: "Selecciona una marca..." }, class: "form-select form-select-lg" %>
  </div>

  <div class="col-12">
    <%= form.label :modelo, class: "form-label fw-bold" %>
    <%= form.text_field :modelo, class: "form-control form-control-lg", placeholder: "Ej. Civic Type R" %>
  </div>

  <div class="col-md-4">
    <%= form.label :anio, class: "form-label fw-bold" %>
    <%= form.number_field :anio, class: "form-control form-control-lg", placeholder: "2026" %>
  </div>

  <div class="col-md-4">
    <%= form.label :color, class: "form-label fw-bold" %>
    <%= form.text_field :color, class: "form-control form-control-lg", placeholder: "Rojo Rally" %>
  </div>
  
  <div class="col-md-4">
    <%= form.label :precio, class: "form-label fw-bold" %>
    <div class="input-group input-group-lg">
      <span class="input-group-text">$</span>
      <%= form.number_field :precio, step: 0.01, class: "form-control" %>
    </div>
  </div>

  <div class="col-12 mt-4 d-flex justify-content-between align-items-center">
    <%= link_to "Cancelar", vehiculos_path, class: "btn btn-outline-secondary px-4 py-2 rounded-pill" %>
    <%= form.submit "Guardar vehículo", class: "btn btn-dark px-4 py-2 rounded-pill" %>
  </div>
<% end %>