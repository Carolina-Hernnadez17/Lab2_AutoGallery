<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "AutoGallery" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AutoGallery">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="vehicle-discover" data-action="keydown.esc@window->vehicle-discover#close">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-autogallery sticky-top">
      <div class="container-fluid autogallery-shell py-2">
        <%= link_to "AutoGallery", root_path, class: "navbar-brand fw-bold brand-mark" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#autogalleryNav" aria-controls="autogalleryNav" aria-expanded="false" aria-label="Alternar navegación">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="autogalleryNav">
          <div class="navbar-nav ms-auto gap-2">
            <%= link_to "Inicio", root_path, class: "nav-link" %>
            <%= link_to "Marcas", marcas_path, class: "nav-link" %>
            <%= link_to "Vehículos", vehiculos_path, class: "nav-link" %>
            <%= link_to "Fotografías", fotografias_path, class: "nav-link" %>
          </div>
        </div>
      </div>
    </nav>

    <main class="autogallery-shell">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <div class="discover-modal" data-vehicle-discover-target="modal" hidden aria-hidden="true">
      <div class="discover-modal__backdrop" data-action="click->vehicle-discover#close"></div>
      <section class="discover-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="discoverVehicleTitle">
        <button type="button" class="discover-modal__close" data-action="click->vehicle-discover#close" aria-label="Cerrar ventana">&times;</button>

        <div class="discover-modal__media">
          <img data-vehicle-discover-target="image" class="discover-modal__image" alt="" hidden>
          <div class="discover-modal__fallback" aria-hidden="true"></div>
        </div>

        <div class="discover-modal__content">
          <p class="section-label mb-2">Detalle rápido</p>
          <h2 class="h3 fw-bold mb-3 discover-modal__title" id="discoverVehicleTitle" data-vehicle-discover-target="title">Vehículo</h2>
          <p class="mb-3"><strong>Marca:</strong> <span data-vehicle-discover-target="brand"></span></p>
          <p class="mb-3"><strong>Precio desde:</strong> <span data-vehicle-discover-target="price"></span></p>
          <p class="mb-3"><strong>Año:</strong> <span data-vehicle-discover-target="year"></span></p>
          <p class="mb-4"><strong>Color:</strong> <span data-vehicle-discover-target="color"></span></p>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-autogallery" data-vehicle-discover-target="link" href="#">Ver ficha</a>
            <button type="button" class="btn btn-outline-autogallery" data-action="click->vehicle-discover#close">Cerrar</button>
          </div>
        </div>
      </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
