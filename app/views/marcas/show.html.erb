<% content_for :title, "AutoGallery | #{@marca.nombre_marca}" %>

<div data-controller="vehicle-discover">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 fade-in-up">
    <div>
      <div class="brand-breadcrumb mb-3">
        <%= link_to "Marcas", marcas_path, class: "btn btn-outline-autogallery btn-sm" %>
        <span class="text-muted">/</span>
        <span class="text-muted"><%= @marca.nombre_marca %></span>
      </div>
      <p class="section-label mb-2">Vehículos de la marca</p>
      <h1 class="display-6 fw-bold mb-2"><%= @marca.nombre_marca %></h1>
      <p class="support-copy mb-0"><%= @marca.pais_origen.presence || "País de origen no especificado" %></p>
    </div>

    <div class="d-flex flex-wrap gap-3">
      <%= link_to "Nuevo vehículo", new_vehiculo_path(marca_id: @marca.id), class: "btn btn-autogallery" %>
      <%= link_to "Editar marca", edit_marca_path(@marca), class: "btn btn-outline-autogallery" %>
      <%= button_to "Eliminar marca", marca_path(@marca), method: :delete, form_class: "d-inline", class: "btn btn-outline-autogallery", data: { turbo_confirm: "¿Seguro que quieres eliminar esta marca? Se borrarán sus vehículos y fotografías." } %>
      <div class="metric-box">
        <strong><%= @vehiculos.size %></strong>
        <span>vehículos</span>
      </div>
      <div class="metric-box">
        <strong><%= @vehiculos.sum { |vehiculo| vehiculo.fotografias.size } %></strong>
        <span>fotografías</span>
      </div>
    </div>
  </div>

  <div class="detail-card p-3 p-md-4 mb-4 fade-in-up">
    <%= form_with url: marca_path(@marca), method: :get, class: "row g-3 align-items-end" do |form| %>
      <div class="col-lg-4">
        <%= form.label :q, "Buscar vehículo", class: "form-label" %>
        <%= form.text_field :q, value: params[:q], class: "form-control form-control-lg", placeholder: "Corolla, Mustang..." %>
      </div>
      <div class="col-lg-3">
        <%= form.label :color, "Color", class: "form-label" %>
        <%= form.text_field :color, value: params[:color], class: "form-control form-control-lg", placeholder: "Rojo, negro..." %>
      </div>
      <div class="col-lg-3">
        <%= form.label :anio, "Año", class: "form-label" %>
        <%= form.number_field :anio, value: params[:anio], class: "form-control form-control-lg", placeholder: "2024" %>
      </div>
      <div class="col-lg-2 d-flex gap-2 flex-wrap">
        <%= form.submit "Filtrar", class: "btn btn-autogallery" %>
        <%= link_to "Limpiar", marca_path(@marca), class: "btn btn-outline-autogallery" %>
      </div>
    <% end %>
  </div>

  <div class="row g-4">
    <% if @vehiculos.any? %>
      <% @vehiculos.each do |vehiculo| %>
        <div class="col-12 col-md-6 col-xl-4">
          <article class="card gallery-card vehicle-card h-100 fade-in-up">
            <div class="cover-frame">
              <% if vehiculo.fotografias.first %>
                <%= image_tag vehiculo.fotografias.first.ruta_archivo, class: "cover-image", alt: vehiculo.modelo, loading: "lazy" %>
              <% else %>
                <div class="cover-fallback"></div>
              <% end %>
            </div>

            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <span class="badge rounded-pill text-bg-light text-dark"><%= vehiculo.anio.presence || "Año no definido" %></span>
                <span class="text-muted"><%= number_to_currency(vehiculo.precio || 0, unit: "$", precision: 0) %></span>
              </div>

              <h2 class="vehicle-name h5 fw-bold mb-2"><%= vehiculo.modelo %></h2>
              <p class="gallery-subtitle mb-4"><%= vehiculo.color.presence || "Color no especificado" %></p>

              <div class="mt-auto d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <small class="text-muted">Marca: <%= @marca.nombre_marca %></small>
                <div class="d-flex gap-2 flex-wrap">
                  <button
                    class="btn btn-autogallery"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#discoverVehicleModal"
                    data-action="click->vehicle-discover#open"
                    data-vehicle-discover-modelo="<%= vehiculo.modelo %>"
                    data-vehicle-discover-precio="<%= vehiculo.precio %>"
                    data-vehicle-discover-anio="<%= vehiculo.anio %>"
                    data-vehicle-discover-color="<%= vehiculo.color %>"
                    data-vehicle-discover-marca="<%= @marca.nombre_marca %>"
                  >
                    Descubrir
                  </button>
                  <%= link_to "Ver galería", vehiculo_path(vehiculo), class: "btn btn-outline-autogallery" %>
                  <%= link_to "Editar", edit_vehiculo_path(vehiculo), class: "btn btn-outline-autogallery" %>
                  <%= button_to "Eliminar", vehiculo_path(vehiculo), method: :delete, form_class: "d-inline", class: "btn btn-outline-autogallery", data: { turbo_confirm: "¿Seguro que quieres eliminar este vehículo y sus fotografías?" } %>
                </div>
              </div>
            </div>
          </article>
        </div>
      <% end %>
    <% else %>
      <div class="col-12">
        <div class="empty-state">
          No se encontraron vehículos con esos filtros.
          <div class="mt-3">
            <%= link_to "Crear vehículo", new_vehiculo_path(marca_id: @marca.id), class: "btn btn-autogallery" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="modal fade" id="discoverVehicleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content autogallery-modal">
        <div class="modal-header border-0">
          <h5 class="modal-title" data-vehicle-discover-target="title">Detalle del vehículo</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" data-action="click->vehicle-discover#close" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2"><strong>Marca:</strong> <span data-vehicle-discover-target="brand"></span></p>
          <p class="mb-2"><strong>Precio desde:</strong> <span data-vehicle-discover-target="price"></span></p>
          <p class="mb-2"><strong>Año:</strong> <span data-vehicle-discover-target="year"></span></p>
          <p class="mb-0"><strong>Color:</strong> <span data-vehicle-discover-target="color"></span></p>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-autogallery" data-bs-dismiss="modal" data-action="click->vehicle-discover#close">Cerrar</button>
        </div>
      </div>
    </div>
  </div>
</div>