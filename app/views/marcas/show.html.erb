<% content_for :title, "AutoGallery | #{@marca.nombre_marca}" %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 fade-in-up">
  <div>
    <div class="brand-breadcrumb mb-3">
      <%= link_to "Marcas", marcas_path, class: "btn btn-outline-autogallery btn-sm" %>
      <span class="text-muted">/</span>
      <span class="text-muted"><%= @marca.nombre_marca %></span>
    </div>
    <p class="section-label mb-2">Vehículos de la marca</p>
    <h1 class="display-6 fw-bold mb-2"><%= @marca.nombre_marca %></h1>
    <p class="support-copy mb-0"><%= @marca.pais_origen.presence || "País de origen no especificado" %></p>
  </div>

  <div class="d-flex flex-wrap gap-3">
    <%= link_to "Nuevo vehículo", new_marca_vehiculo_path(@marca), class: "btn btn-autogallery" %>
    <div class="metric-box">
      <strong><%= @marca.vehiculos.size %></strong>
      <span>vehículos</span>
    </div>
    <div class="metric-box">
      <strong><%= @marca.vehiculos.sum { |vehiculo| vehiculo.fotografias.size } %></strong>
      <span>fotografías</span>
    </div>
  </div>
</div>

<div class="row g-4">
  <% if @marca.vehiculos.any? %>
    <% @marca.vehiculos.order(:modelo).each do |vehiculo| %>
      <div class="col-12 col-md-6 col-xl-4">
        <article class="card gallery-card vehicle-card h-100 fade-in-up">
          <div class="cover-frame">
            <% if vehiculo.fotografias.first %>
              <%= image_tag vehiculo.fotografias.first.ruta_archivo, class: "cover-image", alt: vehiculo.modelo, loading: "lazy" %>
            <% else %>
              <div class="cover-fallback"></div>
            <% end %>
          </div>

          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
              <span class="badge rounded-pill text-bg-light text-dark"><%= vehiculo.anio.presence || "Año no definido" %></span>
              <span class="text-muted"><%= vehiculo.fotografias.size %> fotos</span>
            </div>

            <h2 class="vehicle-name h5 fw-bold mb-2"><%= vehiculo.modelo %></h2>
            <p class="gallery-subtitle mb-4"><%= vehiculo.color.presence || "Color no especificado" %></p>

            <div class="mt-auto d-flex justify-content-between align-items-center gap-3 flex-wrap">
              <small class="text-muted">Marca: <%= @marca.nombre_marca %></small>
              <%= link_to "Ver galería", marca_vehiculo_path(@marca, vehiculo), class: "btn btn-outline-autogallery" %>
            </div>
          </div>
        </article>
      </div>
    <% end %>
  <% else %>
    <div class="col-12">
      <div class="empty-state">
        Esta marca todavía no tiene vehículos cargados.
        <div class="mt-3">
          <%= link_to "Crear vehículo", new_marca_vehiculo_path(@marca), class: "btn btn-autogallery" %>
        </div>
      </div>
    </div>
  <% end %>
</div>