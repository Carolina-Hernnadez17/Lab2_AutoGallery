<% content_for :title, "AutoGallery | Marcas" %>

<section class="hero-panel mb-4 mb-lg-5 fade-in-up">
  <div class="row align-items-center g-4">
    <div class="col-lg-7">
      <p class="hero-kicker mb-3">Galería de autos</p>
      <h1 class="display-4 fw-bold mb-3">AutoGallery</h1>
      <p class="hero-copy lead mb-4">
        Recorre marcas, descubre vehículos asociados y abre cada ficha para ver su galería de fotografías.
      </p>
      <div class="d-flex flex-wrap gap-3">
        <div class="metric-box">
          <strong><%= @marcas.size %></strong>
          <span>marcas disponibles</span>
        </div>
        <div class="metric-box">
          <strong><%= @marcas.sum { |marca| marca.vehiculos.size } %></strong>
          <span>vehículos registrados</span>
        </div>
        <div class="metric-box">
          <strong><%= @marcas.sum { |marca| marca.vehiculos.sum { |vehiculo| vehiculo.fotografias.size } } %></strong>
          <span>fotografías en la galería</span>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="hero-visual"></div>
    </div>
  </div>
</section>

<section class="mb-3 d-flex align-items-end justify-content-between gap-3 flex-wrap">
  <div>
    <p class="section-label mb-2">Marcas destacadas</p>
    <h2 class="h3 fw-bold mb-0">Tarjetas responsivas con Bootstrap</h2>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Nueva marca", new_marca_path, class: "btn btn-autogallery" %>
    <p class="support-copy mb-0 align-self-center">Selecciona una marca para ver sus vehículos y luego entra a su galería.</p>
  </div>
</section>

<div class="detail-card p-3 p-md-4 mb-4 fade-in-up">
  <%= form_with url: marcas_path, method: :get, class: "row g-3 align-items-end" do |form| %>
    <div class="col-lg-5">
      <%= form.label :q, "Buscar marca", class: "form-label" %>
      <%= form.text_field :q, value: @query, class: "form-control form-control-lg", placeholder: "Toyota, Ford, BMW..." %>
    </div>
    <div class="col-lg-4">
      <%= form.label :pais_origen, "País de origen", class: "form-label" %>
      <%= form.text_field :pais_origen, value: @country, class: "form-control form-control-lg", placeholder: "Japón, Alemania..." %>
    </div>
    <div class="col-lg-3 d-flex gap-2 flex-wrap">
      <%= form.submit "Filtrar", class: "btn btn-autogallery" %>
      <%= link_to "Limpiar", marcas_path, class: "btn btn-outline-autogallery" %>
    </div>
  <% end %>
</div>

<div class="row g-4">
  <% @marcas.each do |marca| %>
    <div class="col-12 col-sm-6 col-lg-4">
      <article class="card gallery-card brand-card h-100 fade-in-up">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <span class="badge rounded-pill text-bg-warning text-dark">Marca</span>
            <span class="text-muted"><%= marca.vehiculos.size %> vehículos</span>
          </div>

          <h3 class="brand-name h4 fw-bold mb-2"><%= marca.nombre_marca %></h3>
          <p class="gallery-subtitle mb-4"><%= marca.pais_origen.presence || "País de origen no especificado" %></p>

          <div class="cover-frame rounded-4 mb-4">
            <% if marca.vehiculos.first&.fotografias&.first %>
              <%= image_tag marca.vehiculos.first.fotografias.first.ruta_archivo, class: "cover-image", alt: marca.nombre_marca, loading: "lazy" %>
            <% else %>
              <div class="cover-fallback"></div>
            <% end %>
          </div>

          <div class="mt-auto d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <small class="text-muted">Explora la colección completa</small>
            <div class="d-flex gap-2 flex-wrap">
              <%= link_to "Ver vehículos", marca_path(marca), class: "btn btn-autogallery" %>
              <%= button_to "Eliminar", marca_path(marca), method: :delete, form_class: "d-inline", class: "btn btn-outline-autogallery", data: { turbo_confirm: "¿Seguro que quieres eliminar esta marca? Se borrarán sus vehículos y fotografías." } %>
            </div>
          </div>
        </div>
      </article>
    </div>
  <% end %>
</div>