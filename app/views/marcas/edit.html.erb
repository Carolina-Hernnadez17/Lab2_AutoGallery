<% content_for :title, "AutoGallery | Editar marca" %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="detail-card p-4 p-md-5 fade-in-up">
      <p class="section-label mb-2">Editar marca</p>
      <h1 class="h2 fw-bold mb-4"><%= @marca.nombre_marca %></h1>

      <%= form_with model: @marca, class: "row g-3" do |form| %>
        <% if @marca.errors.any? %>
          <div class="col-12">
            <div class="alert alert-danger">
              <strong>Revisa los datos:</strong>
              <ul class="mb-0">
                <% @marca.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>
        <div class="col-12">
          <%= form.label :nombre_marca, class: "form-label" %>
          <%= form.text_field :nombre_marca, class: "form-control form-control-lg" %>
        </div>

        <div class="col-12">
          <%= form.label :pais_origen, class: "form-label" %>
          <%= form.text_field :pais_origen, class: "form-control form-control-lg" %>
        </div>

        <div class="col-12 d-flex gap-2 flex-wrap">
          <%= form.submit "Actualizar marca", class: "btn btn-autogallery" %>
          <%= link_to "Volver", marca_path(@marca), class: "btn btn-outline-autogallery" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
